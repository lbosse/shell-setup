# ~/.secrets — API tokens and credentials
#
# NEVER commit this file to git. It lives only on your local machine.
# Copy this file to ~/.secrets and fill in your values:
#   cp ~/code/shell-setup/secrets.example ~/.secrets
#   chmod 600 ~/.secrets
#
# This file is sourced by ~/.zshrc.

export JIRA_EMAIL="you@yourcompany.com"
export JIRA_API_TOKEN=""

export ATLASSIAN_EMAIL="you@yourcompany.com"
export ATLASSIAN_MCP_TOKEN=""
# Computed from the above — keep this line after the two vars above
export ATLASSIAN_MCP_BASIC_AUTH=$(echo -n "$ATLASSIAN_EMAIL:$ATLASSIAN_MCP_TOKEN" | openssl base64 -A)
